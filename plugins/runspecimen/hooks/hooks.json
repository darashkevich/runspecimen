{
  "description": "Deny agent-driven RunSpecimen approval and remote-confirm settle. Human TTY approve only.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/block_approve_gate.py\""
          }
        ]
      },
      {
        "matcher": "mcp__plugin_runspecimen_runspecimen__.*|mcp__runspecimen__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/block_approve_gate.py\""
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "runspecimen-block-approve-shell",
            "command": "python3 \"${extensionPath}${/}scripts${/}block_approve_gate.py\" --format gemini"
          }
        ]
      },
      {
        "matcher": "mcp_runspecimen_.*",
        "hooks": [
          {
            "type": "command",
            "name": "runspecimen-block-approve-mcp",
            "command": "python3 \"${extensionPath}${/}scripts${/}block_approve_gate.py\" --format gemini"
          }
        ]
      }
    ]
  }
}

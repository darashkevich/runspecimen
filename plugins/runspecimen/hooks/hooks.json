{
  "description": "Gemini CLI BeforeTool gate: deny agent-driven RunSpecimen approval and remote-confirm settle. Claude/Junie/Grok intentionally use hooks/claude-hooks.json instead — Claude rejects unknown BeforeTool keys in hooks.json.",
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "type": "command",
            "name": "runspecimen-block-approve-shell",
            "command": "python3 \"${extensionPath}${/}scripts${/}block_approve_gate.py\" --format gemini"
          }
        ]
      },
      {
        "matcher": "mcp_runspecimen_.*",
        "hooks": [
          {
            "type": "command",
            "name": "runspecimen-block-approve-mcp",
            "command": "python3 \"${extensionPath}${/}scripts${/}block_approve_gate.py\" --format gemini"
          }
        ]
      }
    ]
  }
}

# Signing / notarization / App Store Connect environment (DO NOT COMMIT secrets)
#
#   cp Config/signing.env.example Config/signing.env
#   # edit signing.env, then:
#   set -a && source Config/signing.env && set +a
#
# MAS (primary): Archive/upload via full Xcode + Apple Distribution (see APP_STORE.md).
# Developer ID (secondary): ./Scripts/sign_and_notarize.sh all

# Codesign identity — Apple Distribution (MAS) or Developer ID Application (direct)
# From: security find-identity -v -p codesigning
# Example: Apple Distribution: Yahor Darashkevich (TEAMID1234)
# Example: Developer ID Application: Yahor Darashkevich (TEAMID1234)
RS_SIGN_IDENTITY=

# Apple Team ID (10 characters)
RS_NOTARY_TEAM_ID=

# --- Preferred: App Store Connect API key (MAS upload + notarytool) ---
# Path to AuthKey_XXXXXXXXXX.p8 (keep outside the repo)
RS_NOTARY_KEY=
RS_NOTARY_KEY_ID=
RS_NOTARY_ISSUER=

# --- Alternative: Apple ID + app-specific password ---
# RS_NOTARY_APPLE_ID=
# RS_NOTARY_PASSWORD=   # app-specific password from appleid.apple.com — not your login password

# Optional override of the .app path (default: build/RunSpecimen.app)
# RS_APP_PATH=
